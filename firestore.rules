rules_version = '2';
// Peraturan keselamatan Firestore untuk Apps Kaiser.
// Salin semua kandungan fail ini ke Firebase console → Firestore Database → Rules → Publish.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function userPath() { return /databases/$(database)/documents/users/$(request.auth.uid); }
    function prof() { return get(userPath()).data; }
    function active() { return signedIn() && exists(userPath()) && prof().get('aktif', true) != false; }
    function role() { return prof().peranan; }
    function isPengarah() { return active() && role() == 'pengarah'; }
    function isPengurus() { return active() && role() in ['pengurus', 'pengarah']; }
    function isAdmin() { return active() && role() in ['pengurus', 'pengarah', 'akaun']; }
    function own(d) { return d.userId == request.auth.uid; }
    function bootstrapped() { return exists(/databases/$(database)/documents/meta/bootstrap); }

    // Pengguna pertama yang log masuk menjadi Pengarah (sekali sahaja).
    match /meta/bootstrap {
      allow read: if signedIn();
      allow create: if signedIn() && !bootstrapped()
        && getAfter(userPath()).data.peranan == 'pengarah';
    }

    match /users/{uid} {
      allow read: if active() || (signedIn() && request.auth.uid == uid);
      allow create: if isPengarah()
        || (signedIn() && request.auth.uid == uid && !bootstrapped()
            && existsAfter(/databases/$(database)/documents/meta/bootstrap)
            && request.resource.data.peranan == 'pengarah');
      allow update: if isPengarah();
    }

    match /settings/{doc} {
      allow read: if active();
      allow write: if isPengarah();
    }

    match /kod/{id} {
      allow read: if active();
      allow create: if isPengurus()
        || (active() && request.resource.data.jenis == 'VO' && own(request.resource.data) && request.resource.data.semak == 'dihantar');
      allow update: if isAdmin();
    }

    match /laporan/{id} {
      allow read: if isAdmin() || (active() && own(resource.data));
      allow create: if active() && own(request.resource.data) && request.resource.data.status == 'dihantar';
      allow update: if isPengurus()
        || (active() && own(resource.data) && own(request.resource.data)
            && resource.data.status == 'dikembalikan' && request.resource.data.status == 'dihantar');
    }

    match /belian/{id} {
      allow read: if isAdmin() || (active() && own(resource.data));
      allow create: if active() && own(request.resource.data) && request.resource.data.status == 'dihantar';
      allow update: if isPengurus()
        || (active() && own(resource.data) && own(request.resource.data)
            && resource.data.status == 'dikembalikan' && request.resource.data.status == 'dihantar');
    }

    match /hadir/{id} {
      allow read: if isAdmin() || (active() && own(resource.data));
      allow create: if active() && own(request.resource.data);
      allow update: if active() && own(resource.data) && own(request.resource.data);
    }

    match /tunai/{id} { allow read, create: if isAdmin(); }
    match /kiraan/{id} { allow read, create: if isAdmin(); }

    match /audit/{id} {
      allow read: if isPengarah();
      allow create: if active() && own(request.resource.data);
    }

    // Gambar disimpan sebagai dokumen berasingan (pelan Spark, tanpa Cloud Storage).
    match /gambar/{id} {
      allow read: if isAdmin() || (active() && resource.data.ownerId == request.auth.uid);
      allow create: if active() && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.data is string && request.resource.data.data.size() < 1000000;
    }
  }
}
